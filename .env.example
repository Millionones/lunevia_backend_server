# ---- Core ----
# MongoDB connection string. Boot throws if this is missing.
DATABASE_URL=mongodb+srv://<user>:<pass>@<cluster>/<db>
# Port the API listens on (default 4000). API base is http://localhost:PORT/api
PORT=4000
# "production" enables Secure/SameSite=None cookies; anything else = dev (lax).
NODE_ENV=development

# ---- Auth ----
# Long random string used to sign the JWT session cookie (tkn).
TOKEN_SECRET=<any-long-random-string>

# ---- Supabase Storage (image bucket "lunevia") ----
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ---- Email (nodemailer / Gmail) ----
EMAIL_USER=<gmail-address>
EMAIL_PASS=<gmail-app-password>

# ---- Admin seed (npm run seed:admin) ----
SEED_ADMIN_EMAIL=admin@lunevia.com
SEED_ADMIN_PASSWORD=<choose-a-strong-password>
SEED_ADMIN_NAME=Admin
